# Copiez ce fichier en `.env` et renseignez les valeurs.
# Le .env est ignoré par git : les secrets ne quittent jamais votre machine.

# --- Hugging Face ---
# Token (gratuit) : https://huggingface.co/settings/tokens
HF_TOKEN=hf_votre_token_ici

# Facultatif : changer les modèles utilisés
# AGENT_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
# GENERATION_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# --- Django ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=remplacez_par_une_longue_cle_aleatoire
DJANGO_DEBUG=1

# --- Production uniquement ---
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=monsite.fr,www.monsite.fr
# DJANGO_CSRF_TRUSTED_ORIGINS=https://monsite.fr
# DATABASE_URL=postgres://user:mdp@hote:5432/base
